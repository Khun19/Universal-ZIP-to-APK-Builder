<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_surface"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <!-- Handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_badge_rounded" />

    <TextView
        android:id="@+id/tv_player_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+1 (555) 019-2834"
        android:textColor="@color/color_on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_player_metadata"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Incoming Call • Aug 17, 2026 10:30 AM"
        android:textColor="@color/color_on_surface_secondary"
        android:textSize="13sp" />

    <!-- Waveform / Seekbar layout -->
    <SeekBar
        android:id="@+id/seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:progressBackgroundTint="@color/color_divider"
        android:progressTint="@color/color_primary"
        android:thumbTint="@color/color_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_current_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/player_duration_zero"
            android:textColor="@color/color_on_surface_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_duration_zero"
            android:textColor="@color/color_on_surface_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Playback Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_rewind_10"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_history"
            app:tint="@color/color_on_surface"
            android:contentDescription="Rewind 10s" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:src="@drawable/ic_play_arrow"
            app:backgroundTint="@color/color_primary"
            app:fabSize="normal"
            app:tint="@color/color_background"
            android:contentDescription="Play or Pause" />

        <ImageButton
            android:id="@+id/btn_share_from_player"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            app:tint="@color/color_on_surface"
            android:contentDescription="@string/btn_share" />

    </LinearLayout>

</LinearLayout>
