<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_call_history">

    <fragment
        android:id="@+id/nav_call_history"
        android:name="com.callrecorder.ry.ui.history.CallHistoryFragment"
        android:label="@string/title_call_history"
        tools:layout="@layout/fragment_call_history">
        <action
            android:id="@+id/action_history_to_detail"
            app:destination="@id/nav_call_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_call_detail"
        android:name="com.callrecorder.ry.ui.detail.CallDetailTimelineFragment"
        android:label="@string/title_call_detail"
        tools:layout="@layout/fragment_call_detail_timeline">
        <argument
            android:name="phoneNumber"
            app:argType="string" />
        <argument
            android:name="contactName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_exclude_list"
        android:name="com.callrecorder.ry.ui.exclude.ExcludeListFragment"
        android:label="@string/title_exclude_list"
        tools:layout="@layout/fragment_exclude_list" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.callrecorder.ry.ui.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
