{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-completion-status.schema.json",
  "title": "Universal ZIP-to-APK Framework Completion Status",
  "type": "object",
  "required": [
    "framework",
    "strategy",
    "overall_status",
    "current_stage",
    "stages"
  ],
  "properties": {
    "framework": { "type": "string", "minLength": 1 },
    "strategy": { "type": "string", "minLength": 1 },
    "official_flow": { "type": "boolean" },
    "overall_status": {
      "enum": ["INCOMPLETE", "BLOCKED", "COMPLETE"]
    },
    "current_stage": { "type": ["string", "null"] },
    "blocked_by": { "type": "array", "items": { "type": "string" } },
    "next_required_action": { "type": ["string", "null"] },
    "prohibited_actions": { "type": "array", "items": { "type": "string" } },
    "last_verified_commit": { "type": ["string", "null"] },
    "last_verified_environment": { "type": ["string", "null"] },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "required",
          "requirements"
        ],
        "properties": {
          "id": { "type": "string" },
          "status": {
            "enum": [
              "NOT_STARTED",
              "IN_PROGRESS",
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "required": { "type": "boolean" },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "goal_reference",
                "acceptance_criteria",
                "status"
              ],
              "properties": {
                "id": { "type": "string" },
                "goal_reference": { "type": "string" },
                "acceptance_criteria": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                },
                "evidence": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "failure": { "type": ["string", "null"] },
                "next_actions": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "status": {
                  "enum": [
                    "NOT_STARTED",
                    "IN_PROGRESS",
                    "PASS",
                    "FAIL",
                    "BLOCKED",
                    "NOT_APPLICABLE"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
